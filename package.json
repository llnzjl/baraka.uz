{
  "name": "restaurant-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "test": "tsx --test tests/booking.unit.test.ts",
    "test:db": "node scripts/test-sqlite.mjs",
    "test:integration": "node --env-file=.env.test.local --import tsx --test tests/booking.integration.test.ts",
    "test:postgres": "node scripts/test-database.mjs",
    "db:import-postgres": "node --env-file=.env.local scripts/import-postgres.mjs",
    "db:backup": "node --env-file=.env.local scripts/backup-sqlite.mjs",
    "test:sqlite:http": "node scripts/test-sqlite-http.mjs"
  },
  "dependencies": {
    "@imagemagick/magick-wasm": "^0.0.30",
    "@types/react": "18.2.15",
    "@types/react-dom": "18.2.7",
    "@types/react-outside-click-handler": "^1.3.1",
    "next": "^15.5.28",
    "pg": "^8.23.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^4.10.1",
    "react-outside-click-handler": "^1.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "autoprefixer": "10.4.14",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.31",
    "tailwindcss": "3.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
