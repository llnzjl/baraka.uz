# Never paste secrets into chat or put database/provider keys in NEXT_PUBLIC_*.
# Supabase direct/session or transaction pooler URL. Use verified TLS in production.
DATABASE_URL=
# Direct/session connection for migrations, separate privileged migration account.
MIGRATION_DATABASE_URL=
APP_ORIGIN=http://localhost:3000
# Public Supabase values are required to build the GitHub Pages frontend. Only use the publishable/anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_REQUIRE_MFA=true
# Domain verified in Resend. Owner notifications contain reference/time only.
RESEND_API_KEY=
RESEND_FROM=
# Owner destination for optional reservation email notifications only; not used for owner login/reset.
OWNER_EMAIL=
# Optional initial display fallbacks; profile changes are stored in PostgreSQL.
OWNER_NAME=
OWNER_PHONE=
# Cloudflare Turnstile widget restricted to the restaurant domain.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Only honored outside production. Never enables fake times or fake bookings.
BOT_PROTECTION_DISABLED=false
# Generate independent random secrets of at least 32 characters.
RATE_LIMIT_SECRET=
CRON_SECRET=
# Header supplied by the hosting edge proxy, e.g. x-forwarded-for on Supabase Edge Functions.
# The application uses the last valid address in a forwarded chain; configure edge limits too.
TRUSTED_IP_HEADER=
# Owner must publish the reviewed privacy notice, including processors/regions/transfers.
PRIVACY_CONTROLLER=
PRIVACY_CONTACT=
PRIVACY_POLICY_URL=
# Tests ONLY: isolated disposable PostgreSQL. The suite will drop the booking schema.
TEST_DATABASE_URL=
ALLOW_TEST_DB_RESET=false

# Initial owner login only; owner profile and password changes are available at /admin/my-page.
# Password hash must be a salted scrypt value generated with scripts/configure-owner.mjs.
OWNER_USERNAME=asf229
OWNER_PASSWORD_HASH=

# Optional private persistent file path; default: project-root reservations.txt. Never place in public/.
RESERVATION_RECORDS_PATH=

# Private table-order export; defaults to project-root orders.txt.
ORDERS_RECORDS_PATH=
# Private served-meal receipt evidence; defaults to project-root receipts.txt.
RECEIPTS_RECORDS_PATH=
